# Secrets
.env
# La configuración del usuario (canal + qué modelo usa). El .example sí se versiona.
settings.json

# Pipeline runtime state
.pipeline_state.json

# Generated media (can be large)
downloads/
clips/
output/
videos/

# Modelo de MediaPipe (se descarga solo en runtime; ~3.6 MB)
models/

# Cache de forma de onda del editor de timeline (se recomputa si falta)
*.peaks.json

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Node / Remotion
remotion/node_modules/
remotion/out/
# Track 2 · episodios. Cada uno es un proyecto Remotion aparte. El VO de
# _entrada/ y captions.json SÍ se versionan: son la fuente de la
# sincronía, no media generada.
episodios/*/node_modules/
episodios/*/out/
episodios/*/build/
episodios/*/whisper.cpp/

# El MATERIAL de un episodio (lo que va en _entrada/): locución, video, fotos de
# referencia. Es contenido, no proyecto — pesa, es distinto en cada episodio y
# suele no ser redistribuible. El repo lleva el código y la plantilla; el
# material lo pone quien hace el episodio (ver episodios/COMO-ENTREGAR.md).
#
# El texto sí se versiona: `brief.md`, `guion.md` y las composiciones de
# referencia son la especificación del episodio y pesan nada.
episodios/*/_entrada/**/*.mp3
episodios/*/_entrada/**/*.wav
episodios/*/_entrada/**/*.m4a
episodios/*/_entrada/**/*.mp4
episodios/*/_entrada/**/*.mov
episodios/*/_entrada/**/*.mkv
episodios/*/_entrada/**/*.png
episodios/*/_entrada/**/*.jpg
episodios/*/_entrada/**/*.jpeg
episodios/*/_entrada/**/*.webp
episodios/_archivo/**/*.zip
# Clip local para previsualizar en Remotion Studio (hardlink a clips/)
remotion/public/
components/clip_editor/frontend/node_modules/
components/clip_ui/frontend/node_modules/
*.tsbuildinfo

# Custom Streamlit component (Track 2): los assets COMPILADOS deben versionarse
# para desplegar sin `npm run build`. La regla global `build/` de arriba los
# excluiría; esta negación los rescata. Ver docs/DEPLOYMENT.md.
!components/clip_editor/frontend/build/
!components/clip_editor/frontend/build/**
!components/clip_ui/frontend/build/
!components/clip_ui/frontend/build/**

# Generated outputs
*.csv

# Legacy scripts
script.py

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/
