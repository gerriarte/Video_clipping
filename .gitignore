# Secrets
.env

# Pipeline runtime state
.pipeline_state.json

# Generated media (can be large)
downloads/
clips/
output/
videos/

# Modelo de MediaPipe (se descarga solo en runtime; ~3.6 MB)
models/

# Cache de forma de onda del editor de timeline (se recomputa si falta)
*.peaks.json

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Node / Remotion
remotion/node_modules/
remotion/out/
# Track 2 · episodios. Cada uno es un proyecto Remotion aparte. El VO de
# _entrada/ y captions.json SÍ se versionan: son la fuente de la
# sincronía, no media generada.
episodios/*/node_modules/
episodios/*/out/
episodios/*/build/
episodios/*/whisper.cpp/
# Clip local para previsualizar en Remotion Studio (hardlink a clips/)
remotion/public/
components/clip_editor/frontend/node_modules/
components/clip_gallery/frontend/node_modules/
*.tsbuildinfo

# Custom Streamlit component (Track 2): los assets COMPILADOS deben versionarse
# para desplegar sin `npm run build`. La regla global `build/` de arriba los
# excluiría; esta negación los rescata. Ver docs/DEPLOYMENT.md.
!components/clip_editor/frontend/build/
!components/clip_editor/frontend/build/**
!components/clip_gallery/frontend/build/
!components/clip_gallery/frontend/build/**

# Generated outputs
*.csv

# Legacy scripts
script.py

# OS
.DS_Store
Thumbs.db

# Claude Code
.claude/
